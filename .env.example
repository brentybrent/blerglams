# Postgres connection string (Neon, etc). Use the pooled connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Spotify Developer app credentials (developer.spotify.com/dashboard)
# Only the Client Credentials flow is used (catalog search + artwork),
# so no redirect URI / user login is required.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Last.fm API key (last.fm/api/account/create), used to find similar artists
# for the Recommendations tab. Free, no OAuth/secret needed.
LASTFM_API_KEY=""

# Discogs personal access token (discogs.com/settings/developers), used to
# show community ratings on the Recommendations tab. Free, no OAuth needed.
DISCOGS_TOKEN=""

# Password used to log in to the app itself (pick any passphrase).
APP_PASSWORD=""

# Random long random string used to sign the login session cookie.
# Generate one with: openssl rand -hex 32
AUTH_SECRET=""
