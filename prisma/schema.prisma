generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AlbumStatus {
  LIBRARY
  SAVED
}

model Album {
  id          String      @id @default(cuid())
  spotifyId   String      @unique
  title       String
  artist      String
  artistId    String?
  imageUrl    String?
  releaseDate String?
  spotifyUrl  String?
  rating      Int?
  status      AlbumStatus @default(LIBRARY)
  createdAt   DateTime    @default(now())
  listens     Listen[]

  @@index([createdAt])
  @@index([status])
}

model Listen {
  id         String   @id @default(cuid())
  albumId    String
  album      Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  listenedAt DateTime
  note       String?
  createdAt  DateTime @default(now())

  @@index([albumId])
  @@index([listenedAt])
}
